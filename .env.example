# =============================================================================
# ORBITO — environment template. Copy to .env and fill in what you have.
# Nothing here is required to boot: with no provider keys ORBITO runs on the
# built-in mock provider so the full product loop stays usable offline.
# =============================================================================

# APPLICATION
APP_NAME=ORBITO
APP_ENV=development
APP_SECRET_KEY=change-me-in-production
APP_CORS_ORIGINS=http://localhost:3000

# FRONTEND
NEXT_PUBLIC_API_URL=http://localhost:8000

# DATABASE — SQLite is the zero-setup dev default. Use the Postgres URL below
# when running the Docker stack (or your own PostgreSQL + pgvector instance).
DATABASE_URL=sqlite+aiosqlite:///./.data/orbito.db
# DATABASE_URL=postgresql+asyncpg://orbito:orbito@localhost:5432/orbito

# REDIS (optional — falls back to in-process queue when unset)
REDIS_URL=redis://localhost:6379/0

# MODEL GATEWAY
# Models are resolved from apps/api/app/config/models.yaml and can be overridden
# per-capability with the variables below.
ORBITO_DEFAULT_MODEL=fast
ORBITO_REASONING_MODEL=
ORBITO_CODING_MODEL=
ORBITO_FAST_MODEL=
ORBITO_VISION_MODEL=
ORBITO_SMART_MODEL=

# PROVIDERS
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

GOOGLE_API_KEY=
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com

MISTRAL_API_KEY=

OLLAMA_BASE_URL=http://localhost:11434
# Local-first: roles in models.yaml resolve to Ollama. Set false to skip it.
OLLAMA_ENABLED=true
# Per-request context budget (memory). 8192 is a good CPU-laptop default.
OLLAMA_CONTEXT_LENGTH=8192
# Thinking roughly triples latency on CPU; enable for hard reasoning only.
OLLAMA_THINK=false

# SYSTEM MONITOR / ALERTS
# Warning fires at the first value; critical at the second.
ALERT_MEMORY_PERCENT=90
ALERT_MEMORY_CRITICAL_PERCENT=96
ALERT_SWAP_PERCENT=80
ALERT_DISK_PERCENT=85
ALERT_DISK_CRITICAL_PERCENT=95
ALERT_CPU_PERCENT=92
ALERT_TEMPERATURE_C=80
ALERT_TEMPERATURE_CRITICAL_C=92
ALERT_BATTERY_PERCENT=20

# VOICE (LiveKit)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# SEARCH TOOL (optional — falls back to DuckDuckGo HTML)
TAVILY_API_KEY=
SERPER_API_KEY=

# SCRAPING
SCRAPING_MAX_PAGES=100
SCRAPING_CONCURRENCY=3
SCRAPING_MAX_DEPTH=3
SCRAPING_ALLOWED_DOMAINS=

# STORAGE (S3 / R2 / MinIO)
S3_ENDPOINT=
S3_BUCKET=orbito
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto

# OBSERVABILITY
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=INFO
